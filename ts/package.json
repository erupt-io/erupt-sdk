{
  "name": "erupt-sdk",
  "version": "0.1.0",
  "description": "Serve Node.js models as an erupt admin UI through an erupt cloud server",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erupt-io/erupt-sdk.git",
    "directory": "ts"
  },
  "scripts": {
    "gen": "node tools/gen-types.mjs ../schema",
    "gen:check": "node tools/gen-types.mjs ../schema --check",
    "build": "tsc -p .",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"dist/test/*.test.js\"",
    "conformance": "npm run build && cd .. && python3 conformance/run.py -- node ts/dist/examples/conformance.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "mysql2": "3.24.4",
    "pg": "8.23.0",
    "typescript": "5.9.3"
  }
}
